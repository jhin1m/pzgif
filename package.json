{
  "name": "pzgif",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-wasm.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:forbidden": "node scripts/check-forbidden-headers.mjs",
    "check:static": "node scripts/check-static-routes.mjs",
    "check:source-sha": "node scripts/check-source-sha.mjs",
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "bench": "playwright test -c playwright.bench.config.ts",
    "bench:soak": "PZGIF_SOAK_RUNS=200 playwright test -c playwright.bench.config.ts g1-soak",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "gifenc": "1.0.3",
    "gifski-wasm": "2.2.0",
    "lucide-react": "1.28.0",
    "mediabunny": "1.52.3",
    "modern-gif": "2.1.0",
    "next": "16.3.0",
    "next-intl": "4.13.5",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "shadcn": "4.16.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.9",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.20.0"
}
